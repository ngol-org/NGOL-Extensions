{
  "id": "ngol-handoff-to-broadcast",
  "name": "素材を書き出して配信ソフトへ載せる",
  "description": "編集ソフトで透過つきの素材を書き出し、そのまま配信ソフトのシーンへ載せて、載ったことを色の割合で確かめるまでを 1 本で通す。2 つのホストを繋いでいるのは ngol.link.* のノードだけで、人も AI も間に入らない。",
  "schemaVersion": "0.2.0",
  "nodes": [
    {
      "instanceId": "n-probe",
      "nodeTypeId": "ngol.link.probe",
      "position": {
        "x": 40,
        "y": 40
      },
      "paramValues": {
        "start_port": 11156,
        "count": 15,
        "name_contains": "obs"
      }
    },
    {
      "instanceId": "n-export",
      "nodeTypeId": "aviutl.edit.capture_movie",
      "position": {
        "x": 40,
        "y": 300
      },
      "paramValues": {
        "output_path": "D:/Temp/ngol_handoff/graph_material.webm",
        "frame_from": 0,
        "frame_to": 59,
        "fps": 30,
        "max_width": 640,
        "keep_alpha": true,
        "encoder_path": "D:/Tools/Movie/ffmpeg/bin/ffmpeg.exe"
      }
    },
    {
      "instanceId": "n-drop",
      "nodeTypeId": "ngol.link.run_node",
      "position": {
        "x": 340,
        "y": 40
      },
      "paramValues": {
        "node_type_id": "obs.source.edit",
        "inputs_json": "{\"name\":\"NGOL Handoff Material\",\"remove\":true}",
        "pick": "result"
      }
    },
    {
      "instanceId": "n-add",
      "nodeTypeId": "ngol.link.run_node",
      "position": {
        "x": 640,
        "y": 40
      },
      "paramValues": {
        "node_type_id": "obs.source.edit",
        "inputs_json": "{\"name\":\"NGOL Handoff Material\",\"id\":\"ffmpeg_source\",\"settings\":\"{\\\"local_file\\\":\\\"{1}\\\",\\\"is_local_file\\\":true,\\\"looping\\\":true,\\\"restart_on_activate\\\":false,\\\"clear_on_media_end\\\":false}\"}",
        "pick": "result"
      }
    },
    {
      "instanceId": "n-fit",
      "nodeTypeId": "ngol.link.run_node",
      "position": {
        "x": 940,
        "y": 40
      },
      "paramValues": {
        "node_type_id": "obs.sceneitem.set",
        "inputs_json": "{\"name\":\"NGOL Handoff Material\",\"x\":0,\"y\":0,\"scale_x\":3.0,\"scale_y\":3.0}",
        "pick": "result"
      }
    },
    {
      "instanceId": "n-check",
      "nodeTypeId": "ngol.link.run_node",
      "position": {
        "x": 1240,
        "y": 40
      },
      "paramValues": {
        "node_type_id": "obs.capture",
        "inputs_json": "{\"output_path\":\"D:/Temp/ngol_handoff/graph_result.png\",\"match_color\":\"ff00ff\",\"max_width\":640}",
        "pick": "match_ratio"
      }
    }
  ],
  "connections": [
    {
      "fromNodeInstanceId": "n-probe",
      "fromPortName": "port",
      "toNodeInstanceId": "n-drop",
      "toPortName": "port"
    },
    {
      "fromNodeInstanceId": "n-probe",
      "fromPortName": "port",
      "toNodeInstanceId": "n-add",
      "toPortName": "port"
    },
    {
      "fromNodeInstanceId": "n-probe",
      "fromPortName": "port",
      "toNodeInstanceId": "n-fit",
      "toPortName": "port"
    },
    {
      "fromNodeInstanceId": "n-probe",
      "fromPortName": "port",
      "toNodeInstanceId": "n-check",
      "toPortName": "port"
    },
    {
      "fromNodeInstanceId": "n-export",
      "fromPortName": "saved_path",
      "toNodeInstanceId": "n-add",
      "toPortName": "arg1"
    },
    {
      "fromNodeInstanceId": "n-drop",
      "fromPortName": "__exec_out__",
      "toNodeInstanceId": "n-add",
      "toPortName": "__exec_in__"
    },
    {
      "fromNodeInstanceId": "n-export",
      "fromPortName": "__exec_out__",
      "toNodeInstanceId": "n-add",
      "toPortName": "__exec_in__"
    },
    {
      "fromNodeInstanceId": "n-add",
      "fromPortName": "__exec_out__",
      "toNodeInstanceId": "n-fit",
      "toPortName": "__exec_in__"
    },
    {
      "fromNodeInstanceId": "n-fit",
      "fromPortName": "__exec_out__",
      "toNodeInstanceId": "n-check",
      "toPortName": "__exec_in__"
    }
  ],
  "fragmentLinks": [],
  "groups": [
    {
      "id": "g1",
      "name": "1. 相手を探す",
      "description": "待ち受けている NGOL を名前で引く。ポート番号は使い回されるうえ、埋まっていれば次の空きへ移るので、グラフに書き固めない。",
      "nodeInstanceIds": [
        "n-probe"
      ]
    },
    {
      "id": "g2",
      "name": "2. 素材を書き出す",
      "description": "編集ソフトに 1 枚ずつ描かせ、そのまま符号化へ流して動画にする。keep_alpha を立てているので透ける所が残り、重ねられる素材になる。",
      "nodeInstanceIds": [
        "n-export"
      ]
    },
    {
      "id": "g3",
      "name": "3. 相手のシーンへ載せる",
      "description": "前回の残りを外してから足し、画面いっぱいに広げる。相手のノードを名前で呼ぶだけで、こちらは相手の作りを何も知らない。",
      "nodeInstanceIds": [
        "n-drop",
        "n-add",
        "n-fit"
      ]
    },
    {
      "id": "g4",
      "name": "4. 載ったことを数で確かめる",
      "description": "相手に描かせて、素材の色が何割あるかを受け取る。人が画面を見ないで判定できる。",
      "nodeInstanceIds": [
        "n-check"
      ]
    }
  ],
  "annotations": []
}