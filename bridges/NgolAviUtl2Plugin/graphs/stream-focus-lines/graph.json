    {
      "instanceId": "n-make",
      "nodeTypeId": "aviutl.edit.create_object",
      "position": {
        "x": 40,
        "y": 300
      },
      "paramValues": {
        "layer": 16,
        "frame": 0,
        "alias": "[Object]\r\nframe=0,59\r\n[Object.0]\r\neffect.name=集中線\r\n濃さ=70.00\r\n速さ=30.00\r\n中心幅=420.00\r\n色=ffee88\r\n[Object.1]\r\neffect.name=標準描画\r\n"
      }
    },
