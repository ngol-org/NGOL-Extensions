        "output_path": "D:/Temp/ngol_stream/focus-lines.webm",
        "frame_from": 0,
        "frame_to": 59,
        "fps": 30,
        "max_width": 640,
        "keep_alpha": true,
        "encoder_path": "D:/Tools/Movie/ffmpeg/bin/ffmpeg.exe"
      }
    },
    {
      "instanceId": "n-drop",
      "nodeTypeId": "ngol.link.run_node",
      "position": {
        "x": 340,
        "y": 40
      },
      "paramValues": {
        "node_type_id": "obs.source.edit",
        "inputs_json": "{\"name\":\"NGOL Focus Lines\",\"remove\":true}",
        "pick": "result"
      }
    },
    {
      "instanceId": "n-add",
      "nodeTypeId": "ngol.link.run_node",
      "position": {
        "x": 640,
        "y": 40
      },
      "paramValues": {
        "node_type_id": "obs.source.edit",
        "inputs_json": "{\"name\":\"NGOL Focus Lines\",\"id\":\"ffmpeg_source\",\"settings\":\"{\\\"local_file\\\":\\\"{1}\\\",\\\"is_local_file\\\":true,\\\"looping\\\":true,\\\"restart_on_activate\\\":false,\\\"clear_on_media_end\\\":false}\"}",
        "pick": "result"
      }
    },
    {
      "instanceId": "n-fit",
      "nodeTypeId": "ngol.link.run_node",
      "position": {
        "x": 940,
        "y": 40
      },
      "paramValues": {
        "node_type_id": "obs.sceneitem.set",
        "inputs_json": "{\"name\":\"NGOL Focus Lines\",\"x\":0,\"y\":0,\"scale_x\":3.0,\"scale_y\":3.0}",
        "pick": "result"
      }
    },
    {
      "instanceId": "n-check",
      "nodeTypeId": "ngol.link.run_node",
      "position": {
        "x": 1240,
        "y": 40
      },
      "paramValues": {
        "node_type_id": "obs.capture",
        "inputs_json": "{\"output_path\":\"D:/Temp/ngol_stream/stream-focus-lines.png\",\"match_color\":\"ffee88\",\"match_tolerance\":60,\"max_width\":640}",
        "pick": "match_ratio"
      }
    }
