  "fragmentLinks": [],
  "groups": [
    {
      "id": "g1",
      "name": "1. 相手を探す",
      "description": "待ち受けている NGOL を名前で引く。番号を書き固めない。",
      "nodeInstanceIds": [
        "n-probe"
      ]
    },
    {
      "id": "g0",
      "name": "0. 場を片付ける",
      "description": "書き出しは画面全体を描く。他の見本が残っていると混ざり、しかも別の素材が出来ただけでは失敗に見えない。使う帯を消してから自分だけ出す。",
      "nodeInstanceIds": [
        "n-hide16",
        "n-hide17",
        "n-hide18",
        "n-hide19",
        "n-hide20",
        "n-show"
      ]
    },
    {
      "id": "g2",
      "name": "2. 素材を作って書き出す",
      "description": "効果を組み、透過つきで書き出す。keep_alpha を落とすと重ねられない。",
      "nodeInstanceIds": [
        "n-make",
        "n-export"
      ]
    },
    {
      "id": "g3",
      "name": "3. 相手のシーンへ載せる",
      "description": "前回の残りを外してから足し、画面いっぱいに広げる。",
      "nodeInstanceIds": [
        "n-drop",
        "n-add",
        "n-fit"
      ]
    },
    {
      "id": "g4",
      "name": "4. 載ったことを数で確かめる",
      "description": "素材の色が何割あるかを受け取る。人が画面を見ない。",
      "nodeInstanceIds": [
        "n-check"
      ]
    }
  ],
