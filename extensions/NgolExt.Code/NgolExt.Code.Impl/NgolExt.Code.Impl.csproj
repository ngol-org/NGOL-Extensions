<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>NgolExt.Code.Impl</AssemblyName>
    <RootNamespace>NgolExt.Code</RootNamespace>
    <!-- ホストのランタイムは配備先ごとに違う（CoreCLR / Mono）。
         この DLL は capability を宣言するだけで、どちらからも読めるよう最小の土台に合わせる。 -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.0.0</Version>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildThisFileDirectory)=/_/</PathMap>
  </PropertyGroup>

  <ItemGroup>
    <!-- 逆アセンブラ本体。ノードは lib/<tfm>/ へ配置された結果を直接 using する。 -->
    <PackageReference Include="iced" Version="1.21.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\NodeGraphModLab\NodeGraphModLab.NodeAPI\NodeGraphModLab.NodeAPI.csproj" />
  </ItemGroup>

</Project>
